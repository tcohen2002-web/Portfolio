---
interface Props {
  slug: string;
}
const { slug } = Astro.props;
---

{slug === 'ollie' && (
  <svg
    data-glyph
    aria-hidden="true"
    viewBox="0 0 1200 360"
    preserveAspectRatio="xMidYMid slice"
    fill="none"
    stroke="currentColor"
    stroke-linecap="round"
    stroke-linejoin="round"
    class="glyph absolute inset-0 h-full w-full text-ink transition-colors duration-300 md:group-hover:text-white"
  >
    {/* orbital web of nodes + lines is generated into this group */}
    <g data-web stroke="currentColor" />

    {/* ── five Olympic rings: drawn one at a time, centred in the network ── */}
    <g data-seq data-delay="0" data-step="200" stroke-width="9">
      <circle class="draw" pathLength="1" cx="715" cy="155" r="52" stroke="#0E76C4" />
      <circle class="draw" pathLength="1" cx="815" cy="155" r="52" stroke="#141419" />
      <circle class="draw" pathLength="1" cx="915" cy="155" r="52" stroke="#E0452A" />
      <circle class="draw" pathLength="1" cx="765" cy="205" r="52" stroke="#F2C014" />
      <circle class="draw" pathLength="1" cx="865" cy="205" r="52" stroke="#2E9E4F" />
    </g>
  </svg>
)}

