{slug === 'mira' && (
  <svg
    data-glyph
    aria-hidden="true"
    viewBox="0 0 1200 360"
    preserveAspectRatio="xMidYMid slice"
    fill="none"
    stroke-linecap="round"
    stroke-linejoin="round"
    data-glyph
    data-mira-glyph
    class="glyph absolute inset-0 h-full w-full"
  >
    {/* procedural garden: grass + flowering plants grow up from the bottom */}
    <g data-garden />
  </svg>
)}

<style is:global>
  .glyph { overflow: visible; }
  @media (max-width: 767px) {
    [data-court] { transform: translateX(170px); }
    [data-rafa-logo] { transform: translate(698px, 77px) scale(1.2); }
  }

  [data-mira-glyph] { color: #4A6E47; }

  /* Latched state: colour bg + white text — applies on all devices */
  .group.is-latched [data-latch-bg] { opacity: 1; }
  .group.is-latched [data-latch-text] { color: white; }
  .group.is-latched [data-glyph] { color: white; }
  .group.is-latched [data-mira-glyph] { color: #2D4A2A; }

  /* Post-latch hover (desktop only): text flips to ink */
  @media (hover: hover) {
    .group:hover [data-mira-glyph] { color: #4A6E47; }
    .group.is-latched-rested:hover [data-latch-text] { color: var(--ink, #0B0B0E); }
    .group.is-latched-rested:hover [data-glyph] { color: var(--ink, #0B0B0E); }
    .group.is-latched-rested:hover [data-mira-glyph] { color: #2D4A2A; }
    .group.is-latched-rested:hover [data-white-petal] { fill: #1B3A1A; }
  }

  .glyph .draw {
    stroke-dasharray: 1;
    stroke-dashoffset: 1;
    opacity: 0;
    transition:
      stroke-dashoffset 0.32s cubic-bezier(0.65, 0, 0.35, 1),
      opacity 0.01s linear;
  }
  .glyph.is-live .draw {
    stroke-dashoffset: 0;
    opacity: 1;
  }

  .glyph .pop {
    opacity: 0;
    transform: scale(0);
    transform-box: fill-box;
    transform-origin: center;
    transition:
      opacity 0.2s ease,
      transform 0.3s cubic-bezier(0.34, 1.56, 0.64, 1);
  }
  .glyph.is-live .pop {
    opacity: 1;
    transform: scale(1);
  }

  @media (prefers-reduced-motion: reduce) {
    .glyph .draw { transition: none; stroke-dashoffset: 0; opacity: 1; }
    .glyph .pop { transition: none; opacity: 1; transform: none; }
  }
</style>

<script>
  const SVGNS = 'http://www.w3.org/2000/svg';

  // stable seeded PRNG so the constellation is identical every load
  function rng(seed: number) {
    return () => {
      seed = (seed + 0x6d2b79f5) | 0;
      let t = Math.imul(seed ^ (seed >>> 15), 1 | seed);
      t = (t + Math.imul(t ^ (t >>> 7), 61 | t)) ^ t;
      return ((t ^ (t >>> 14)) >>> 0) / 4294967296;
    };
  }

  function buildWeb(g: SVGElement) {
    const web = g.querySelector<SVGGElement>('[data-web]');
    if (!web || web.dataset.built) return;
    web.dataset.built = '1';

    const cx = 815;
    const cy = 180;
    const RX = 350;
    const RY = 124;
    const rand = rng(7);

    type Node = { x: number; y: number; r: number; op: number; d: number };
    const nodes: Node[] = [];

    // jittered grid sampled inside the ellipse → an even but organic blob
    const cellW = 56;
    const cellH = 40;
    for (let gx = cx - RX; gx <= cx + RX; gx += cellW) {
      for (let gy = cy - RY; gy <= cy + RY; gy += cellH) {
        const x = gx + (rand() - 0.5) * cellW * 0.9;
        const y = gy + (rand() - 0.5) * cellH * 0.9;
        const nx = (x - cx) / RX;
        const ny = (y - cy) / RY;
        if (nx * nx + ny * ny > 1) continue;
        const big = rand() > 0.85;
        nodes.push({
          x,
          y,
          r: big ? 3.4 + rand() * 3.2 : 1.5 + rand() * 1.8,
          op: big ? 0.8 + rand() * 0.2 : 0.4 + rand() * 0.45,
          d: Math.hypot(x - cx, y - cy),
        });
      }
    }

    // k-nearest-neighbour triangulation, de-duplicated
    type Edge = { a: Node; b: Node; mx: number; my: number; dist: number };
    const edges: Edge[] = [];
    const seen = new Set<string>();
    const K = 4;
    nodes.forEach((n, i) => {
      const order = nodes
        .map((m, j) => ({ j, d: Math.hypot(m.x - n.x, m.y - n.y) }))
        .filter((o) => o.j !== i)
        .sort((a, b) => a.d - b.d)
        .slice(0, K);
      order.forEach((o) => {
        const key = i < o.j ? `${i}-${o.j}` : `${o.j}-${i}`;
        if (seen.has(key)) return;
        seen.add(key);
        const m = nodes[o.j];
        const mx = (n.x + m.x) / 2;
        const my = (n.y + m.y) / 2;
        edges.push({ a: n, b: m, mx, my, dist: Math.hypot(mx - cx, my - cy) });
      });
    });

    // lines sweep outward from the centre as they draw in
    edges.sort((a, b) => a.dist - b.dist);
    edges.forEach((e, i) => {
      const dark = rand() > 0.72;
      const path = document.createElementNS(SVGNS, 'path');
      path.setAttribute('d', `M${e.a.x.toFixed(1)} ${e.a.y.toFixed(1)} L${e.b.x.toFixed(1)} ${e.b.y.toFixed(1)}`);
      path.setAttribute('pathLength', '1');
      path.setAttribute('fill', 'none');
      path.setAttribute('stroke', 'currentColor');
      path.setAttribute('stroke-width', dark ? '1.3' : '0.9');
      path.setAttribute('stroke-opacity', (dark ? 0.42 : 0.16 + rand() * 0.14).toFixed(2));
      path.setAttribute('class', 'draw');
      path.style.transitionDelay = `${850 + i * 8}ms`;
      web.appendChild(path);
    });

    // nodes pop in from centre outward, painting over the lines
    const byDist = [...nodes].sort((a, b) => a.d - b.d);
    byDist.forEach((n, i) => {
      const dot = document.createElementNS(SVGNS, 'circle');
      dot.setAttribute('cx', n.x.toFixed(1));
      dot.setAttribute('cy', n.y.toFixed(1));
      dot.setAttribute('r', n.r.toFixed(1));
      dot.setAttribute('fill', 'currentColor');
      dot.setAttribute('fill-opacity', n.op.toFixed(2));
      dot.setAttribute('stroke', 'none');
      dot.setAttribute('class', 'pop');
      dot.style.transitionDelay = `${810 + i * 12}ms`;
      web.appendChild(dot);
    });
  }

  function buildGarden(g: SVGElement) {
    const garden = g.querySelector<SVGGElement>('[data-garden]');
    if (!garden || garden.dataset.built) return;
    garden.dataset.built = '1';

    const W = 1200;
    const baseY = 360;
    const rand = rng(19);

    const textClearX = window.innerWidth < 768 ? 620 : 470;
    const STEM_GREEN = '#1B5E20';
    const LEAF_GREEN = '#2E7D32';
    const GRASS_GREEN = 'currentColor';
    const flowerColors = ['#FF595E', '#FFCA3A', '#F2789F', '#9B6BD6', '#FF8C42', '#F4F1EA'];

    const addPath = (
      d: string,
      stroke: string,
      width: number,
      delay: number,
      cls: string,
      opacity = 1
    ) => {
      const p = document.createElementNS(SVGNS, 'path');
      p.setAttribute('d', d);
      p.setAttribute('pathLength', '1');
      p.setAttribute('fill', 'none');
      p.setAttribute('stroke', stroke);
      p.setAttribute('stroke-width', width.toFixed(1));
      if (opacity < 1) p.setAttribute('stroke-opacity', opacity.toFixed(2));
      p.setAttribute('class', cls);
      p.style.transitionDelay = `${delay}ms`;
      garden.appendChild(p);
      return p;
    };

    // ── ground grass: thin blades fanning up from the baseline ──
    const BLADES = 56;
    for (let i = 0; i < BLADES; i++) {
      const x = (i + rand() * 0.8) * (W / BLADES);
      if (x < textClearX) continue;
      const h = 48 + rand() * 86;
      const lean = (rand() - 0.5) * 26;
      const cx = x + lean * 0.5;
      const d = `M${x.toFixed(1)} ${baseY} Q${cx.toFixed(1)} ${(baseY - h * 0.6).toFixed(1)} ${(x + lean).toFixed(1)} ${(baseY - h).toFixed(1)}`;
      addPath(d, GRASS_GREEN, 2.2, rand() * 240, 'draw', 0.5 + rand() * 0.4);
    }

    // ── flowering plants growing up, staggered left → right ──
    const FLOWERS = 17;
    for (let i = 0; i < FLOWERS; i++) {
      const x = 46 + (i + (rand() - 0.5) * 0.5) * ((W - 92) / FLOWERS);
      if (x < textClearX) continue;
      const tierTop = [126, 158, 190][i % 3];
      const topY = tierTop + rand() * 34;
      const sway = (rand() - 0.5) * 70;
      const stemDelay = 150 + i * 56;

      // curved stem, bottom-to-top
      const midY = (baseY + topY) / 2;
      const stemD = `M${x.toFixed(1)} ${baseY} Q${(x + sway).toFixed(1)} ${midY.toFixed(1)} ${(x + sway * 0.6).toFixed(1)} ${topY.toFixed(1)}`;
      addPath(stemD, STEM_GREEN, 3, stemDelay, 'draw');

      const headX = x + sway * 0.6;
      const headY = topY;

      // 1–2 leaves along the stem (rotation baked into geometry)
      const leaves = rand() > 0.5 ? 2 : 1;
      for (let l = 0; l < leaves; l++) {
        const t = 0.42 + l * 0.26 + rand() * 0.08;
        const lx = x + sway * (1 - t) * 0.8 + sway * 0.6 * t;
        const ly = baseY + (topY - baseY) * t;
        const dir = l % 2 === 0 ? 1 : -1;
        const len = 30 + rand() * 16;
        const tipX = lx + dir * len;
        const tipY = ly - 8 - rand() * 8;
        const cxl = lx + dir * len * 0.5;
        const cyU = ly - 22 - rand() * 6;
        const cyD = ly + 2;
        const leafD = `M${lx.toFixed(1)} ${ly.toFixed(1)} Q${cxl.toFixed(1)} ${cyU.toFixed(1)} ${tipX.toFixed(1)} ${tipY.toFixed(1)} Q${cxl.toFixed(1)} ${cyD.toFixed(1)} ${lx.toFixed(1)} ${ly.toFixed(1)} Z`;
        const leaf = document.createElementNS(SVGNS, 'path');
        leaf.setAttribute('d', leafD);
        leaf.setAttribute('fill', LEAF_GREEN);
        leaf.setAttribute('stroke', 'none');
        leaf.setAttribute('class', 'pop');
        leaf.style.transitionDelay = `${stemDelay + 160 + l * 90}ms`;
        garden.appendChild(leaf);
      }

      // flower head: ring of petals + center, pops after the stem draws
      const headDelay = stemDelay + 300;
      const petalColor = flowerColors[Math.floor(rand() * flowerColors.length)];
      const petals = 5 + Math.floor(rand() * 3);
      const petalR = 11 + rand() * 6;
      const ringR = petalR * 0.95;
      for (let pI = 0; pI < petals; pI++) {
        const a = (pI / petals) * Math.PI * 2 + rand() * 0.2;
        const px = headX + Math.cos(a) * ringR;
        const py = headY + Math.sin(a) * ringR;
        const petal = document.createElementNS(SVGNS, 'circle');
        petal.setAttribute('cx', px.toFixed(1));
        petal.setAttribute('cy', py.toFixed(1));
        petal.setAttribute('r', petalR.toFixed(1));
        petal.setAttribute('fill', petalColor);
        petal.setAttribute('stroke', 'none');
        petal.setAttribute('class', 'pop');
        if (petalColor === '#F4F1EA') petal.setAttribute('data-white-petal', '');
        petal.style.transitionDelay = `${headDelay + pI * 26}ms`;
        garden.appendChild(petal);
      }
      const center = document.createElementNS(SVGNS, 'circle');
      center.setAttribute('cx', headX.toFixed(1));
      center.setAttribute('cy', headY.toFixed(1));
      center.setAttribute('r', (petalR * 0.72).toFixed(1));
      center.setAttribute('fill', petalColor === '#FFCA3A' ? '#C9633F' : '#FFCA3A');
      center.setAttribute('stroke', 'none');
      center.setAttribute('class', 'pop');
      center.style.transitionDelay = `${headDelay + petals * 26 + 40}ms`;
      garden.appendChild(center);
    }
  }

  function choreograph(g: SVGElement) {
    g.querySelectorAll<SVGElement>('[data-seq]').forEach((group) => {
      const base = parseInt((group as HTMLElement).dataset.delay || '0', 10);
      const step = parseInt((group as HTMLElement).dataset.step || '60', 10);
      group.querySelectorAll<SVGElement>('.draw, .pop').forEach((el, i) => {
        el.style.transitionDelay = `${base + i * step}ms`;
      });
    });
    buildWeb(g);
    buildGarden(g);
  }

  function initGlyphs() {
    const glyphs = document.querySelectorAll<SVGElement>('[data-glyph]');
    if (!glyphs.length) return;

    const prefersReduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    if (prefersReduced) {
      glyphs.forEach((g) => {
        buildWeb(g);
        buildGarden(g);
        g.classList.add('is-live');
      });
      return;
    }

    const canHover = window.matchMedia('(hover: hover)').matches;

    if (canHover) {
      const glyphArray = Array.from(glyphs);
      const queued = new Set<SVGElement>();
      const queue: SVGElement[] = [];
      let animating = false;

      function getAnimDuration(g: SVGElement): number {
        let max = 0;
        g.querySelectorAll<SVGElement>('.draw, .pop').forEach((el) => {
          const d = parseFloat(el.style.transitionDelay) || 0;
          if (d > max) max = d;
        });
        return max + 400;
      }

      function drainQueue() {
        if (animating || queue.length === 0) return;
        const g = queue.shift()!;
        animating = true;
        choreograph(g);
        // Double rAF lets the browser paint the initial hidden state before transitions fire
        requestAnimationFrame(() => requestAnimationFrame(() => {
          g.classList.add('is-live');
          const card = g.closest('a') as HTMLElement | null;
          if (card) card.classList.add('is-latched');
          const dur = getAnimDuration(g);
          setTimeout(() => {
            animating = false;
            drainQueue();
          }, dur);
        }));
      }

      function enqueue(g: SVGElement) {
        if (queued.has(g)) return;
        queued.add(g);
        const idx = glyphArray.indexOf(g);
        let insertAt = queue.length;
        for (let i = 0; i < queue.length; i++) {
          if (glyphArray.indexOf(queue[i]) > idx) { insertAt = i; break; }
        }
        queue.splice(insertAt, 0, g);
        drainQueue();
      }

      glyphs.forEach((g) => {
        const card = g.closest('a') as HTMLElement | null;
        const target = card ?? g;
        const io = new IntersectionObserver((entries) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting) {
              io.disconnect();
              enqueue(g);
            }
          });
        }, { threshold: 0.5 });
        io.observe(target);

        if (card) {
          card.addEventListener('mouseleave', () => {
            if (card.classList.contains('is-latched') && !card.classList.contains('is-latched-rested')) {
              card.classList.add('is-latched-rested');
            }
          });
        }
      });
      return;
    }

    glyphs.forEach((g) => {
      buildWeb(g);
      buildGarden(g);
      g.classList.add('is-live');
      const card = g.closest('a') as HTMLElement | null;
      if (card) card.classList.add('is-latched');
    });
  }

  document.addEventListener('astro:page-load', initGlyphs);
</script>
