---
import BaseLayout from '~/layouts/BaseLayout.astro';
import StickmanWave from '~/components/StickmanWave.astro';
import CardGlyph from '~/components/CardGlyph.astro';

const projects = [
  {
    slug: 'ollie',
    n: '01',
    title: 'Ollie',
    year: '2024',
    tagline: 'A multimodal social network connecting Olympic athletes across cultures.',
    bg: '#F4F1EA',
    hoverBg: '#AFA3CE',
    glyph: true,
  },
  {
    slug: 'mira',
    n: '02',
    title: 'Mira',
    year: '2025',
    tagline: 'An interactive plant: a gentle emotional mirror for young adults and parents living apart.',
    bg: '#F4F1EA',
    hoverBg: '#B1C9AE',
    glyph: true,
  },
  {
    slug: 'vamos-bites',
    n: '03',
    title: 'Vamos Bites',
    year: '2025',
    tagline: "A compact tribute to Rafael Nadal: chocolate, ritual, and Spanish identity in a clay-court timber box.",
    bg: '#F4F1EA',
    hoverBg: '#DA724F',
    glyph: true,
  },
  {
    slug: 'mates-and-matches',
    n: '04',
    title: 'Mates & Matches',
    year: '2026',
    tagline: 'An inclusive platform helping international students in Sydney find beginner-friendly social sports.',
    bg: null,
    comingSoon: true,
  },
];
---

<BaseLayout
  title="Tal Cohen"
  description="UX/UI designer based in Sydney."
>
  <section class="relative mx-auto flex min-h-[100svh] max-w-[1600px] flex-col px-6 pb-16 pt-[72vw] md:px-14 md:pb-10 md:pt-[36vw]">
    <svg
      data-stickman
      aria-hidden="true"
      viewBox="0 0 200 320"
      fill="none"
      stroke="currentColor"
      stroke-width="3"
      stroke-linecap="round"
      stroke-linejoin="round"
      class="absolute right-[10vw] top-[10vw] hidden h-[28vw] w-auto cursor-pointer text-ink md:right-[14vw] md:top-[8vw] md:block"
    >
      <circle cx="155" cy="22" r="7" />
      <path d="M150 36 L154 42" />
      <path d="M160 36 L156 42" />

      <path d="M82 36 L78 24" />
      <path d="M92 33 L92 20" />
      <path d="M102 34 L106 22" />
      <path d="M112 38 L118 28" />

      <circle cx="95" cy="55" r="22" />
      <circle cx="88" cy="53" r="1.6" fill="currentColor" />
      <circle cx="103" cy="53" r="1.6" fill="currentColor" />
      <path d="M84 46 L92 48" />
      <path d="M99 48 L107 46" />
      <path d="M90 64 Q95 67 100 64" />

      <path d="M95 78 L95 205" />

      <path d="M95 82 L88 105 L95 180 L102 105 Z" fill="currentColor" />

      <path d="M95 100 L140 60 L150 32" />
      <circle cx="150" cy="32" r="4" />

      <path d="M95 100 L55 135" />
      <path d="M55 135 L42 152" />
      <ellipse cx="32" cy="168" rx="18" ry="23" transform="rotate(-22 32 168)" />
      <path d="M20 152 L42 184" />
      <path d="M14 162 L34 188" />
      <path d="M30 146 L52 172" />
      <path d="M42 150 L20 178" />

      <path d="M95 205 L72 285" />
      <path d="M95 205 L122 290" />
      <ellipse cx="68" cy="288" rx="7" ry="3" />
      <ellipse cx="128" cy="292" rx="7" ry="3" />
    </svg>

    <script>
      function initStickman() {
        const stickman = document.querySelector<HTMLElement>('[data-stickman]');
        if (!stickman) return;
        const prefersReduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
        const ballSvg = (color: string) => `<svg viewBox="0 0 40 40" fill="none" stroke="${color}" stroke-width="2.6" stroke-linecap="round" style="width:100%;height:100%;display:block;"><circle cx="20" cy="20" r="16"/><path d="M5.5 13 Q20 22 34.5 13"/><path d="M5.5 27 Q20 18 34.5 27"/></svg>`;

        type Ball = {
          el: HTMLDivElement;
          x: number; y: number;
          vx: number; vy: number;
          rot: number; rotSpeed: number;
          r: number;
          bornAt: number;
        };

        const balls: Ball[] = [];
        let running = false;
        const GRAVITY = 2200;
        const RESTITUTION = 0.62;
        const FRICTION = 0.86;
        const LIFETIME = 3.2;
        const FADE_START = 2.4;

        const loop = (() => {
          let last = 0;
          return (now: number) => {
            if (!last) last = now;
            const dt = Math.min((now - last) / 1000, 0.033);
            last = now;
            const floor = window.innerHeight - 4;
            const rightWall = window.innerWidth - 4;

            for (let i = balls.length - 1; i >= 0; i--) {
              const b = balls[i];
              b.vy += GRAVITY * dt;
              b.x += b.vx * dt;
              b.y += b.vy * dt;
              b.rot += b.rotSpeed * dt;

              if (b.y + b.r > floor) {
                b.y = floor - b.r;
                if (Math.abs(b.vy) < 60) {
                  b.vy = 0;
                  b.vx *= 0.92;
                  b.rotSpeed *= 0.92;
                } else {
                  b.vy = -b.vy * RESTITUTION;
                  b.vx *= FRICTION;
                  b.rotSpeed *= FRICTION;
                }
              }
              if (b.x - b.r < 4) {
                b.x = b.r + 4;
                b.vx = -b.vx * RESTITUTION;
              } else if (b.x + b.r > rightWall) {
                b.x = rightWall - b.r;
                b.vx = -b.vx * RESTITUTION;
              }

              const age = (now - b.bornAt) / 1000;
              let opacity = 1;
              if (age > FADE_START) {
                opacity = Math.max(0, 1 - (age - FADE_START) / (LIFETIME - FADE_START));
              }
              if (age > LIFETIME) {
                b.el.remove();
                balls.splice(i, 1);
                continue;
              }

              b.el.style.transform = `translate3d(${b.x - b.r}px, ${b.y - b.r}px, 0) rotate(${b.rot}rad)`;
              b.el.style.opacity = `${opacity}`;
            }

            if (balls.length > 0) {
              requestAnimationFrame(loop);
            } else {
              running = false;
              last = 0;
            }
          };
        })();

        const spawn = () => {
          if (prefersReduced) return;
          const rect = stickman.getBoundingClientRect();
          const cx = rect.left + rect.width * 0.5;
          const cy = rect.top + rect.height * 0.42;
          const now = performance.now();

          const COUNT = 22;
          for (let i = 0; i < COUNT; i++) {
            const el = document.createElement('div');
            const size = 28 + Math.random() * 16;
            el.style.cssText = `position:fixed;left:0;top:0;width:${size}px;height:${size}px;pointer-events:none;z-index:60;will-change:transform,opacity;`;
            el.innerHTML = ballSvg(stickman.style.color || '#0B0B0E');
            document.body.appendChild(el);

            const angle = -Math.PI / 2 + (Math.random() - 0.5) * Math.PI * 1.35;
            const speed = 520 + Math.random() * 480;
            balls.push({
              el,
              x: cx + (Math.random() - 0.5) * 20,
              y: cy + (Math.random() - 0.5) * 20,
              vx: Math.cos(angle) * speed,
              vy: Math.sin(angle) * speed,
              rot: 0,
              rotSpeed: (Math.random() - 0.5) * 22,
              r: size / 2,
              bornAt: now,
            });
          }

          if (!running) {
            running = true;
            requestAnimationFrame(loop);
          }
        };

        const stickColors = ['#AFA3CE', '#B1C9AE', '#DA724F', '#6BA8C4'];
        let stickColorIdx = -1;
        stickman.style.transition = 'color 280ms ease';
        stickman.style.cursor = 'pointer';

        const triggerStickman = () => {
          stickColorIdx = (stickColorIdx + 1) % stickColors.length;
          stickman.style.color = stickColors[stickColorIdx];
          spawn();
        };

        // First trigger: all letters lit
        document.addEventListener('tal-cohen-lit', triggerStickman, { once: true });

        // Subsequent triggers: click
        stickman.addEventListener('click', triggerStickman);
      }

      document.addEventListener('astro:page-load', initStickman);
    </script>

    <div class="mb-10 flex flex-wrap items-center gap-2 md:mb-6">
      <div class="inline-flex w-fit items-center gap-2 rounded-full border border-ink/20 bg-paper px-3 py-1.5">
        <span class="relative inline-flex h-2 w-2">
          <span class="absolute inline-flex h-full w-full animate-ping rounded-full opacity-75" style="background-color: #22C55E;"></span>
          <span class="relative inline-flex h-2 w-2 rounded-full" style="background-color: #22C55E;"></span>
        </span>
        <span class="font-mono text-[12px] uppercase tracking-[0.18em]">Open to work</span>
      </div>
      <a
        href="/cv"
        class="group inline-flex w-fit items-center gap-2 rounded-full border border-ink/20 bg-paper px-3 py-1.5 transition-colors hover:border-ink/60"
      >
        <svg
          aria-hidden="true"
          viewBox="0 0 16 16"
          width="11"
          height="11"
          fill="none"
          stroke="currentColor"
          stroke-width="1.6"
          stroke-linecap="round"
          stroke-linejoin="round"
          class="text-ink"
        >
          <path d="M5.2 7.2 V5 a2.8 2.8 0 0 1 5.6 0 V7.2" />
          <rect x="3.2" y="7.2" width="9.6" height="7" rx="1.2" />
          <circle cx="8" cy="10.6" r="0.7" fill="currentColor" stroke="none" />
        </svg>
        <span class="font-mono text-[12px] uppercase tracking-[0.18em]">View CV</span>
      </a>
    </div>

    <p class="max-w-[62ch] font-display text-2xl italic leading-snug text-ink md:text-3xl md:leading-[1.2]">
      Hi, I'm Tal, a UX/UI designer, sticky-note hoarder, and big fan of products that don't need a manual. Let's build something your users will thank you for.
    </p>

    <div class="mt-12 grid grid-cols-2 items-start gap-6 md:mt-8 md:grid-cols-12">
      <div class="md:col-span-3">
        <p class="font-mono text-[12px] uppercase tracking-[0.18em] text-mute">Currently<span class="hidden md:inline"> Designing</span></p>
        <p class="mt-1 text-sm md:text-base">@ Aeris Tech</p>
      </div>
      <div class="md:col-span-3">
        <p class="font-mono text-[12px] uppercase tracking-[0.18em] text-mute">Based</p>
        <p class="mt-1 text-sm md:text-base">Sydney · open to relocate</p>
      </div>
    </div>

    <div class="flex-1"></div>

    <a
      href="#work"
      class="group mt-16 flex w-fit items-center gap-2 self-center font-mono text-[12px] uppercase tracking-[0.18em] text-mute hover:text-ink md:mt-12"
    >
      <span aria-hidden="true" class="inline-block transition-transform group-hover:translate-y-0.5">↓</span>
      <span>Scroll</span>
    </a>

    <div data-hero-sentinel class="pointer-events-none h-px w-px" aria-hidden="true"></div>
  </section>

  <section id="work" aria-labelledby="work-heading" class="scroll-mt-16 border-t border-ink/15">
    <div class="mx-auto max-w-[1600px] px-6 py-6 md:px-14 md:py-8">
      <div class="flex flex-col gap-2 sm:flex-row sm:items-baseline sm:justify-between">
        <h2
          id="work-heading"
          class="font-mono text-[12px] uppercase tracking-[0.18em] text-mute"
        >
          Selected Work · 2023–2025
        </h2>
        <span class="font-mono text-[12px] uppercase tracking-[0.18em] text-mute">
          3 projects
        </span>
      </div>
    </div>

    <ul class="border-t border-ink/15">
      {projects.map((p) => {
        const inner = (
          <div class="mx-auto flex min-h-[160px] max-w-[1600px] items-stretch md:min-h-0">
            {p.glyph && 'hoverBg' in p && p.hoverBg && (
              <div
                aria-hidden="true"
                data-latch-bg
                class="pointer-events-none absolute inset-0 z-0 opacity-0 transition-opacity duration-300 md:group-hover:opacity-100"
                style={`background-color: ${p.hoverBg}`}
              />
            )}
            {p.glyph && (
              <div aria-hidden="true" class="pointer-events-none absolute inset-0 z-0 overflow-hidden">
                <CardGlyph slug={p.slug} />
              </div>
            )}
            {/* Left: content */}
            <div class:list={['relative z-10 flex flex-col justify-between px-4 py-5 md:flex-1 md:min-h-[340px] md:px-14 md:py-12', p.glyph ? 'w-[55%] md:w-auto' : 'w-full']}>
              <div>
                <span data-latch-text class:list={[
                  'font-mono text-[10px] uppercase tracking-[0.18em] text-mute md:text-[11px]',
                  p.glyph && 'transition-colors duration-300 md:group-hover:text-white',
                ]}>{p.n}</span>
                <div data-latch-text class:list={[
                  'relative mt-2 font-sans text-[1.75rem] font-medium leading-none tracking-[-0.03em] md:mt-3 md:text-[5.5rem]',
                  p.comingSoon ? 'text-ink/40' : 'text-ink',
                  p.glyph && 'transition-colors duration-300 md:group-hover:text-white',
                ]}>
                  {p.title}
                  {p.comingSoon && (
                    <span class="ml-2 inline-block translate-y-[-0.4em] rounded-full border border-ink/30 px-2 py-0.5 font-mono text-[8px] uppercase tracking-[0.15em] leading-none text-ink/60 md:ml-3 md:translate-y-[-0.5em] md:px-2.5 md:py-1 md:text-[11px]">
                      Coming soon
                    </span>
                  )}
                </div>
                <p data-latch-text class:list={[
                  'mt-2 text-xs leading-snug md:mt-4 md:text-lg',
                  p.comingSoon ? 'max-w-[72%] md:max-w-[46ch]' : 'max-w-[46ch]',
                  p.comingSoon ? 'text-ink/40' : 'text-mute',
                  p.glyph && 'transition-colors duration-300 md:group-hover:text-white',
                ]}>
                  {p.tagline}
                </p>
              </div>
              <span data-latch-text class:list={[
                'mt-4 hidden font-mono text-[11px] uppercase tracking-[0.18em] text-mute md:mt-6 md:block',
                p.glyph && 'transition-colors duration-300 md:group-hover:text-white',
              ]}>{p.year}</span>
            </div>
            {!p.glyph && (
              <div aria-hidden="true" class="pointer-events-none absolute inset-0 z-20 ring-[6px] ring-inset ring-transparent transition-all duration-200 md:group-hover:ring-ink/50" />
            )}
          </div>
        );
        return (
          <li class="relative z-10 overflow-hidden border-b border-ink/15">
            {p.comingSoon ? (
              <div aria-disabled="true" class="cursor-not-allowed select-none">
                {inner}
              </div>
            ) : (
              <a
                href={`/work/${p.slug}`}
                style={p.bg ? `background-color: ${p.bg}` : ''}
                class="group relative block"
              >
                {inner}
              </a>
            )}
          </li>
        );
      })}
    </ul>
  </section>

  <section class="mx-auto max-w-[1600px] px-6 py-28 md:px-14 md:py-40">
    <div class="grid grid-cols-1 gap-10 md:grid-cols-12">
      <div class="md:relative md:col-span-3">
        <p class="font-mono text-[12px] uppercase tracking-[0.18em] text-mute">
          About
        </p>
        <div class="mt-8 md:absolute md:-bottom-10 md:left-0 md:mt-0">
          <StickmanWave />
        </div>
      </div>
      <div class="md:col-span-9">
        <p class="font-display text-2xl leading-tight md:text-4xl">
          Hi, I'm Tal.
        </p>
        <div class="mt-10 space-y-5 text-base leading-relaxed text-ink/80 md:mt-12 md:text-lg">
          <p>
            I'm a UX/UI designer based in Sydney. Growing up across three continents and spending a decade as a competitive tennis player gave me a global perspective and a curiosity about how people think, communicate, and connect.
          </p>
          <p>
            I'm drawn to the details most people never notice but always feel: the interactions, transitions, and moments that make technology feel intuitive.
          </p>
          <p>
            I enjoy turning research and ideas into experiences that are thoughtful, accessible, and genuinely useful.
          </p>
          <p>
            Outside of design, you'll usually find me perfecting my carbonara, tracking down a secret surf break, or missing two-foot putts.
          </p>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
